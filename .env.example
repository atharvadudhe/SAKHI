# ─────────────────────────────────────────────────────────────────────────────
# SAKHI – Credential Reference
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file as a reference. Actual secrets go into:
#   • lib/firebase_options.dart        (generated by FlutterFire CLI)
#   • android/app/src/main/AndroidManifest.xml   (Google Maps key)
#   • ios/Runner/AppDelegate.swift / Info.plist  (Google Maps key)
# NEVER commit real API keys to version control.
# ─────────────────────────────────────────────────────────────────────────────


# ─────────────────────────────────────────────────────────────────────────────
# 1. FIREBASE
# ─────────────────────────────────────────────────────────────────────────────
# These values come from: Firebase Console → Project Settings → General → Your Apps
# They are embedded automatically when you run:
#   dart pub global activate flutterfire_cli
#   flutterfire configure
# That command generates lib/firebase_options.dart with the values below.
#
# Required Firebase services to ENABLE in the console:
#   ✅ Authentication  → Phone sign-in provider
#   ✅ Cloud Firestore → create database (start in test or production mode)
#   ✅ Firebase Cloud Messaging (FCM) → enabled by default with the SDK

FIREBASE_PROJECT_ID=your-firebase-project-id

# Android app (package name: com.example.sakhi)
FIREBASE_ANDROID_API_KEY=AIzaSy-REPLACE-WITH-YOUR-ANDROID-KEY
FIREBASE_ANDROID_APP_ID=1:000000000000:android:xxxxxxxxxxxxxxxx
FIREBASE_ANDROID_MESSAGING_SENDER_ID=000000000000
FIREBASE_ANDROID_STORAGE_BUCKET=your-project-id.appspot.com

# iOS app (bundle ID: com.example.sakhi)
FIREBASE_IOS_API_KEY=AIzaSy-REPLACE-WITH-YOUR-IOS-KEY
FIREBASE_IOS_APP_ID=1:000000000000:ios:xxxxxxxxxxxxxxxx
FIREBASE_IOS_CLIENT_ID=000000000000-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com
FIREBASE_IOS_BUNDLE_ID=com.example.sakhi

# Web app (optional – only if you add web support)
FIREBASE_WEB_API_KEY=AIzaSy-REPLACE-WITH-YOUR-WEB-KEY
FIREBASE_WEB_APP_ID=1:000000000000:web:xxxxxxxxxxxxxxxx
FIREBASE_WEB_AUTH_DOMAIN=your-project-id.firebaseapp.com
FIREBASE_WEB_MEASUREMENT_ID=G-XXXXXXXXXX


# ─────────────────────────────────────────────────────────────────────────────
# 2. GOOGLE MAPS
# ─────────────────────────────────────────────────────────────────────────────
# Get this from: https://console.cloud.google.com/apis/credentials
# Required APIs to ENABLE in Google Cloud Console:
#   ✅ Maps SDK for Android
#   ✅ Maps SDK for iOS
#
# → Android: paste the key into android/app/src/main/AndroidManifest.xml
#            under the meta-data tag  com.google.android.geo.API_KEY
#
# → iOS:     paste the key into ios/Runner/AppDelegate.swift
#            GMSServices.provideAPIKey("YOUR_KEY_HERE")
#            AND add GMSApiKey to ios/Runner/Info.plist

GOOGLE_MAPS_API_KEY_ANDROID=AIzaSy-REPLACE-WITH-YOUR-ANDROID-MAPS-KEY
GOOGLE_MAPS_API_KEY_IOS=AIzaSy-REPLACE-WITH-YOUR-IOS-MAPS-KEY


# ─────────────────────────────────────────────────────────────────────────────
# 3. FIREBASE CLOUD MESSAGING (FCM)
# ─────────────────────────────────────────────────────────────────────────────
# No separate key needed for the Flutter SDK – FCM is included via firebase_messaging.
# For sending server-side push notifications you will need one of:
#   • FCM Server Key (legacy)  → Firebase Console → Project Settings → Cloud Messaging
#   • Google Service Account JSON (recommended for HTTP v1 API)

FCM_SERVER_KEY=AAAA-REPLACE-WITH-YOUR-FCM-SERVER-KEY


# ─────────────────────────────────────────────────────────────────────────────
# 4. PHONE AUTHENTICATION (Firebase)
# ─────────────────────────────────────────────────────────────────────────────
# No separate API key – uses Firebase Auth Phone provider.
# Steps to enable:
#   1. Firebase Console → Authentication → Sign-in method → Phone → Enable
#   2. Add test phone numbers (optional, for development) under the same section
#   3. For Android: SHA-1 & SHA-256 fingerprints must be registered
#      Run:  cd android && ./gradlew signingReport
#      Then add fingerprints in Firebase Console → Project Settings → Android App


# ─────────────────────────────────────────────────────────────────────────────
# SETUP CHECKLIST
# ─────────────────────────────────────────────────────────────────────────────
# [ ] Create Firebase project at https://console.firebase.google.com
# [ ] Add Android app (package: com.example.sakhi) and download google-services.json
#       → place at android/app/google-services.json
# [ ] Add iOS app (bundle: com.example.sakhi) and download GoogleService-Info.plist
#       → place at ios/Runner/GoogleService-Info.plist
# [ ] Enable Phone Authentication in Firebase Console
# [ ] Enable Cloud Firestore and set security rules (see firestore.rules)
# [ ] Enable Firebase Cloud Messaging
# [ ] Get Google Maps API key and set it in AndroidManifest.xml and AppDelegate.swift
# [ ] Run: flutterfire configure  (generates lib/firebase_options.dart)
# [ ] Run: flutter run
